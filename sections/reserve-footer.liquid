<style>
  .rf{background:#151716;color:rgba(244,241,235,.9);padding:88px 0 40px}
  .rf a{color:inherit;text-decoration:none}
  .rf-top{max-width:620px;margin:0 auto 72px;text-align:center}
  .rf-h{font-family:Georgia,"Iowan Old Style","Palatino Linotype","Times New Roman",serif;font-weight:400;font-size:clamp(32px,3.4vw,44px);line-height:1.1;letter-spacing:-.01em;color:#f6f2eb;margin:0 0 14px}
  .rf-sub{font-size:15.5px;line-height:1.6;color:rgba(244,241,235,.72);margin:0 0 28px}
  .rf-field{display:flex;align-items:center;border:1px solid rgba(244,241,235,.45);height:62px;padding:0 8px 0 22px;transition:border-color .2s}
  .rf-field:focus-within{border-color:#f6f2eb}
  .rf-field input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#f6f2eb;font:inherit;font-size:15px;letter-spacing:.04em}
  .rf-field input::placeholder{color:rgba(244,241,235,.55)}
  .rf-field button{width:48px;height:48px;border:0;background:transparent;color:#f6f2eb;cursor:pointer;display:flex;align-items:center;justify-content:center}
  .rf-field svg{width:24px;height:24px}
  .rf-vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .rf-ok{font-size:15px;color:#f6f2eb;margin:0;padding:18px 0;border:1px solid rgba(244,241,235,.3)}
  .rf-form .errors{font-size:13px;color:#e4b09a;margin-top:10px}
  .rf-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
  .rf-brand{font-size:13px;font-weight:700;letter-spacing:.32em;text-transform:uppercase;color:#f6f2eb;margin:0 0 14px}
  .rf-tag{font-size:14px;line-height:1.6;color:rgba(244,241,235,.6);margin:0;max-width:240px}
  .rf-t{font-size:11.5px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#f6f2eb;margin:0 0 22px}
  .rf ul{list-style:none;margin:0;padding:0;display:grid;gap:14px}
  .rf li a{font-size:15px;letter-spacing:.05em;color:rgba(244,241,235,.82);transition:color .2s}
  .rf li a:hover{color:#fff}
  .rf li em{font-style:normal;font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:rgba(244,241,235,.45);margin-left:8px;vertical-align:2px}
  .rf-social{display:flex;justify-content:center;gap:34px;margin-top:64px;padding-top:36px;border-top:1px solid rgba(244,241,235,.16)}
  .rf-social a{font-size:11.5px;letter-spacing:.22em;text-transform:uppercase;color:rgba(244,241,235,.82)}
  .rf-social a:hover{color:#fff}
  .rf-legal{display:flex;justify-content:center;flex-wrap:wrap;gap:12px 36px;margin-top:32px}
  .rf-legal a{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:rgba(244,241,235,.7);text-decoration:underline;text-underline-offset:4px;text-decoration-color:rgba(244,241,235,.35)}
  .rf-fda{font-size:11.5px;line-height:1.6;color:rgba(244,241,235,.45);text-align:center;max-width:760px;margin:30px auto 0}
  .rf-copy{font-size:11.5px;letter-spacing:.08em;color:rgba(244,241,235,.45);text-align:center;margin:12px 0 0}
  @media(max-width:900px){
    .rf-cols{grid-template-columns:1fr 1fr;gap:44px 24px}
  }
  @media(max-width:640px){
    .rf{padding:60px 0 32px}
    .rf-top{margin-bottom:52px}
    .rf-h{font-size:32px}
    .rf-sub{font-size:15px}
    .rf-field{height:58px;padding-left:18px}
    .rf-t{margin-bottom:18px}
    .rf li a{font-size:15px}
    .rf-social{gap:24px;margin-top:48px;padding-top:30px}
    .rf-legal{gap:14px 24px}
    .rf-legal a{font-size:10.5px;letter-spacing:.08em}
  }
</style>
<footer class="rf">
  <div class="wrap">
    <div class="rf-top">
      <h2 class="rf-h">{{ section.settings.nl_title | default: 'Let’s Stay Connected' }}</h2>
      <p class="rf-sub">{{ section.settings.nl_text | default: 'Launch updates, new releases and research notes from Reserve Nutrition.' }}</p>
      {% form 'customer', class: 'rf-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}<p class="rf-ok">{{ section.settings.nl_success | default: 'You’re on the list.' }}</p>{% else %}<label class="rf-field"><span class="rf-vh">Email</span><input type="email" name="contact[email]" placeholder="Email" autocomplete="email" required><button type="submit" aria-label="Subscribe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h17M14 6l6 6-6 6"/></svg></button></label>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
    </div>
    <div class="rf-cols">
      {%- assign col_open = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          {%- if col_open -%}</ul></div>{%- endif -%}
          <div {{ block.shopify_attributes }}><h3 class="rf-t">{{ block.settings.heading }}</h3><ul>
          {%- assign col_open = true -%}
        {%- elsif col_open -%}
          <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}{%- if block.settings.tag != blank -%}<em>{{ block.settings.tag }}</em>{%- endif -%}</a></li>
        {%- endif -%}
      {%- endfor -%}
      {%- if col_open -%}</ul></div>{%- endif -%}
    </div>
    <div class="rf-social">
      {%- for i in (1..3) -%}{%- assign lk = 'social_' | append: i | append: '_label' -%}{%- assign uk = 'social_' | append: i | append: '_url' -%}{%- if section.settings[lk] != blank -%}<a href="{{ section.settings[uk] | default: '#' }}">{{ section.settings[lk] }}</a>{%- endif -%}{%- endfor -%}
    </div>
    <div class="rf-legal">
      {%- for i in (1..3) -%}{%- assign lk = 'legal_' | append: i | append: '_label' -%}{%- assign uk = 'legal_' | append: i | append: '_url' -%}{%- if section.settings[lk] != blank -%}<a href="{{ section.settings[uk] | default: '#' }}">{{ section.settings[lk] }}</a>{%- endif -%}{%- endfor -%}
    </div>
    <p class="rf-fda">{{ section.settings.fda | default: '*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.' }}</p>
    <p class="rf-copy">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: 'Reserve Nutrition' }}</p>
  </div>
</footer>
{% schema %}{"name": "Footer", "max_blocks": 40, "settings": [{"type": "header", "content": "Newsletter"}, {"type": "text", "id": "nl_title", "label": "Heading", "default": "Let’s Stay Connected"}, {"type": "textarea", "id": "nl_text", "label": "Text", "default": "Launch updates, new releases and research notes from Reserve Nutrition."}, {"type": "text", "id": "nl_success", "label": "Success message", "default": "You’re on the list."}, {"type": "header", "content": "Social links"}, {"type": "text", "id": "social_1_label", "label": "Social 1 name", "default": "Instagram"}, {"type": "text", "id": "social_1_url", "label": "Social 1 link", "default": "#"}, {"type": "text", "id": "social_2_label", "label": "Social 2 name", "default": "Facebook"}, {"type": "text", "id": "social_2_url", "label": "Social 2 link", "default": "#"}, {"type": "text", "id": "social_3_label", "label": "Social 3 name", "default": "Pinterest"}, {"type": "text", "id": "social_3_url", "label": "Social 3 link", "default": "#"}, {"type": "header", "content": "Legal links"}, {"type": "text", "id": "legal_1_label", "label": "Legal link 1 name", "default": "Privacy Policy"}, {"type": "text", "id": "legal_1_url", "label": "Legal link 1 URL", "default": "/policies/privacy-policy"}, {"type": "text", "id": "legal_2_label", "label": "Legal link 2 name", "default": "Terms of Service"}, {"type": "text", "id": "legal_2_url", "label": "Legal link 2 URL", "default": "/policies/terms-of-service"}, {"type": "text", "id": "legal_3_label", "label": "Legal link 3 name", "default": "Shipping & Returns"}, {"type": "text", "id": "legal_3_url", "label": "Legal link 3 URL", "default": "/policies/shipping-policy"}, {"type": "header", "content": "Bottom text"}, {"type": "textarea", "id": "fda", "label": "Disclaimer", "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."}, {"type": "text", "id": "copyright", "label": "Copyright name", "default": "Reserve Nutrition"}], "blocks": [{"type": "column", "name": "Column heading", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Column"}]}, {"type": "link", "name": "Link", "settings": [{"type": "text", "id": "label", "label": "Text", "default": "Link"}, {"type": "text", "id": "url", "label": "Link", "info": "For example /pages/contact or a full https:// address.", "default": "#"}, {"type": "text", "id": "tag", "label": "Small tag", "info": "Optional, for example Soon."}]}], "default": {"blocks": [{"type": "column", "settings": {"heading": "Shop by need"}}, {"type": "link", "settings": {"label": "Cognition", "url": "/products/reserve-nutrition-cognition"}}, {"type": "link", "settings": {"label": "Sleep", "url": "/collections/all", "tag": "Soon"}}, {"type": "link", "settings": {"label": "Longevity", "url": "/collections/all", "tag": "Soon"}}, {"type": "column", "settings": {"heading": "Learn"}}, {"type": "link", "settings": {"label": "The Science", "url": "/pages/science"}}, {"type": "link", "settings": {"label": "Ingredients", "url": "/pages/science"}}, {"type": "link", "settings": {"label": "Our Story", "url": "/pages/about"}}, {"type": "link", "settings": {"label": "Journal", "url": "/blogs/news"}}, {"type": "link", "settings": {"label": "Global Retailers", "url": "#"}}, {"type": "link", "settings": {"label": "Wholesale", "url": "/pages/contact"}}, {"type": "column", "settings": {"heading": "Resources"}}, {"type": "link", "settings": {"label": "Contact", "url": "/pages/contact"}}, {"type": "link", "settings": {"label": "Account", "url": "/account"}}, {"type": "link", "settings": {"label": "FAQs", "url": "/#faq"}}, {"type": "link", "settings": {"label": "Referrals", "url": "#"}}, {"type": "link", "settings": {"label": "Manage Subscriptions", "url": "/account"}}, {"type": "link", "settings": {"label": "Brand Ambassadors", "url": "/pages/contact"}}]}}{% endschema %}
