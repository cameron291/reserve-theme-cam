<script>
  (function () {
    document.querySelectorAll('[data-rp-form]').forEach(function (panel) {
      var qty = panel.querySelector('input[name="quantity"]');
      var set = function (v) { qty.value = Math.max(1, parseInt(v, 10) || 1); };
      var dec = panel.querySelector('[data-rp-dec]');
      var inc = panel.querySelector('[data-rp-inc]');
      if (dec) dec.addEventListener('click', function () { set(Number(qty.value) - 1); });
      if (inc) inc.addEventListener('click', function () { set(Number(qty.value) + 1); });
      if (qty) qty.addEventListener('change', function () { set(qty.value); });
      var select = panel.querySelector('[data-rp-variant-select]');
      var idInput = panel.querySelector('[data-rp-variant-id]');
      if (select && idInput) select.addEventListener('change', function () { idInput.value = select.value; });
      var form = panel.querySelector('form');
      var pricesEl = panel.querySelector('[data-rp-prices]');
