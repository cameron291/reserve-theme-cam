  <section class="rp-hero">
    <div class="rp-gallery" data-rp-gallery>
      <div class="rp-main">
        {% if product.featured_media %}
          {{ product.featured_media.preview_image | image_url: width: 1400 | image_tag: alt: product.title, loading: 'eager' }}
        {% else %}
          <div class="rp-fallback"><strong>Reserve Nutrition</strong><span>Drive</span></div>
        {% endif %}
        <div class="rp-main-ph" data-rp-main-ph hidden></div>
        <button type="button" class="rp-arrow rp-prev" data-rp-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="rp-arrow rp-next" data-rp-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
