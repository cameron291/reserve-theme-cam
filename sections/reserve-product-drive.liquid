    .rp-hex{max-width:440px}
    .rp-hex-label{font-size:9.5px;letter-spacing:.1em;left:9%;right:9%}
    .rp-ing-facts{min-width:0;width:auto;padding:0 24px;font-size:13px;letter-spacing:.14em;white-space:nowrap}
    .rp-ingl summary{padding:16px 4px}
    .rp-ingl-name{font-size:15.5px;letter-spacing:.1em}
    .rp-ingl-short{font-size:14px}
    .rp-ingl summary:after{width:20px;height:20px}
    .rp-qa{padding:70px 0}
    .rp-qa-grid{grid-template-columns:1fr;grid-template-areas:"text" "img" "cta";row-gap:34px}
    .rp-qa-cta{margin-top:0}
