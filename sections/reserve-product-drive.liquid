        {%- for media in product.media -%}<button type="button" class="rp-thumb" data-rp-thumb data-full="{{ media.preview_image | image_url: width: 1400 }}" aria-label="View image {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}>{{ media.preview_image | image_url: width: 240 | image_tag: alt: '' }}</button>{%- endfor -%}
        {%- if rp_ph_count > 0 -%}{%- for i in (1..rp_ph_count) -%}<button type="button" class="rp-thumb" data-rp-thumb aria-label="View placeholder image {{ i }}">{{ rp_ph_names[forloop.index0] | placeholder_svg_tag }}</button>{%- endfor -%}{%- endif -%}
      </div>
    </div>

    <div class="rp-info">
      {%- assign rp_rating = product.metafields.reviews.rating.value.rating | default: 0 -%}
