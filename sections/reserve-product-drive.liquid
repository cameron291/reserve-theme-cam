      <h1 class="rp-title">{{ product.title }}</h1>
      <a class="rp-rating" href="#judgeme_product_reviews"><span class="rp-stars" style="--rp-r:{{ rp_rating }}" aria-hidden="true">★★★★★</span><span class="rp-rating-count">{% if rp_count > 0 %}{{ rp_count }} {% if rp_count == 1 %}Review{% else %}Reviews{% endif %}{% else %}No reviews yet{% endif %}</span></a>
