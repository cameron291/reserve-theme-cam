    .rp-next{right:12px}
    .rp-info{position:static}
    .rp-controls{flex-direction:column;align-items:flex-start}
    .rp-status{text-align:left;padding-bottom:0}
    .rp-why{padding:76px 0}
    .rp-why-in{grid-template-columns:1fr;gap:54px}
    .rp-grid{gap:11px;max-width:320px}
    .rp-sfb{grid-template-columns:1fr;gap:56px}
    .rp-stats strong{font-size:34px}
    .rp-ing{padding:64px 0}
    .rp-ing-head{margin-bottom:30px}
    .rp-ing-sub{font-size:16px}
