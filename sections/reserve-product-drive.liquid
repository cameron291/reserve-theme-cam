          <div class="rp-trust-row"><svg class="rp-flag" viewBox="0 0 22 15" aria-hidden="true"><rect x=".5" y=".5" width="21" height="14" fill="none" stroke="currentColor"/><path d="M1 2.5h20M1 5h20M1 7.5h20M1 10h20M1 12.5h20" stroke="currentColor" stroke-width="1.1"/><rect x=".5" y=".5" width="9" height="7.5" fill="currentColor"/></svg>{{ section.settings.origin_text }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.lab_name != blank -%}
        <a class="rp-lab" href="{{ section.settings.lab_url | default: '#' }}">
          <span class="rp-lab-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg></span>
          <span class="rp-lab-copy">
            <span class="rp-lab-top">Tested by {{ section.settings.lab_name }}{% if section.settings.lab_date != blank %} in <span class="rp-lab-date">{{ section.settings.lab_date }}</span>{% endif %}</span>
            {%- if section.settings.lab_sub != blank -%}<span class="rp-lab-sub">{{ section.settings.lab_sub }} <span aria-hidden="true">&rarr;</span></span>{%- endif -%}
          </span>
        </a>
        {%- endif -%}
        <div class="rp-faq">
          {%- for i in (1..4) -%}
            {%- capture rp_qk -%}q{{ i }}{%- endcapture -%}
            {%- capture rp_ak -%}a{{ i }}{%- endcapture -%}
            {%- if section.settings[rp_qk] != blank -%}
            <details><summary>{{ section.settings[rp_qk] }}</summary><p class="rp-faq-a">{{ section.settings[rp_ak] }}</p></details>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <p class="rp-note">Target formula shown. Final doses, base, and shelf-life claims are confirmed through production and stability testing before launch.</p>
        <script type="application/json" data-rp-variants>{{ product.variants | json }}</script>
        <script type="application/json" data-rp-prices>{ {%- for v in product.variants -%}"{{ v.id }}":{"p":{{ v.price }},"s":{ {%- for a in v.selling_plan_allocations -%}"{{ a.selling_plan.id }}":{{ a.price }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }</script>
      </div>
    </div>
  </section>
</div>

