{% comment %}
  Section contract.
  Drive closing banner: eyebrow, heading, text and a button that jumps back to the buy
  box, beside the product image (or a chosen image). The buy box sticky bar hides while
  this banner is on screen.
  @example
  <!-- Section in templates/product.drive.json -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign banner_image = s.image
  if banner_image == blank and product.featured_media
    assign banner_image = product.featured_media.preview_image
  endif
-%}
{% render 'reserve-drive-styles' %}

<div class="dp">
  {%- if s.heading != blank -%}
    <section class="dp-close">
      <div class="dp-wrap">
        <div class="dp-close-card">
          <div>
            {%- if s.eyebrow != blank -%}<p class="dp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
            <h2 class="dp-h2">{{ s.heading | escape }}</h2>
            {%- if s.sub != blank -%}<p class="dp-sub">{{ s.sub | escape }}</p>{%- endif -%}
            <a class="dp-cta" href="#dp-buy">{{ s.button | default: 'Shop now' | escape }}</a>
          </div>
          {%- if banner_image != blank -%}
            <div class="dp-close-media">{{ banner_image | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 340px, 80vw' }}</div>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Drive closing banner",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Subscribe & save 25%" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start your daily Drive." },
    { "type": "textarea", "id": "sub", "label": "Text", "default": "Two gummies a day. Subscribe for monthly delivery, or buy a single jar." },
    { "type": "text", "id": "button", "label": "Button label", "info": "Scrolls back to the buy box.", "default": "Shop Drive" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Defaults to the product's main image." }
  ],
  "presets": [{ "name": "Drive closing banner" }]
}
{% endschema %}