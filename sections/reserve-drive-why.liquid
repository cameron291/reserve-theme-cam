{% comment %}
  Section contract.
  Drive "Why Drive" cards: heading plus up to four tinted cards, each a Card block.
  @example
  <!-- Section in templates/product.drive.json -->
{% endcomment %}
{%- assign cards = section.blocks | where: 'type', 'card' -%}
{% render 'reserve-drive-styles' %}

<div class="dp">
  {%- if cards.size > 0 -%}
    <section class="dp-sec dp-why">
      <div class="dp-wrap">
        <div class="dp-head">
          {%- if section.settings.eyebrow != blank -%}<p class="dp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="dp-h2">{{ section.settings.heading | escape }}</h2>
        </div>
        <div class="dp-why-grid">
          {%- for block in cards -%}
            {%- if block.settings.title != blank -%}
              <article class="dp-why-card" {{ block.shopify_attributes }}>
                <span class="dp-why-icon">{% render 'reserve-drive-icon', name: block.settings.icon %}</span>
                <h3>{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Drive why",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Drive" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple by design." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 8,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "target", "options": [{ "value": "refresh", "label": "Subscription" }, { "value": "shield", "label": "Shield" }, { "value": "leaf", "label": "Leaf" }, { "value": "calendar", "label": "Calendar" }, { "value": "doc", "label": "Label" }, { "value": "truck", "label": "Shipping" }, { "value": "flask", "label": "Lab" }, { "value": "target", "label": "Target" }] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Drive why",
      "blocks": [
        { "type": "card", "settings": { "icon": "target", "title": "Focused formula", "text": "One primary active and two supporting minerals, in a compact three-ingredient stack." } },
        { "type": "card", "settings": { "icon": "doc", "title": "Fully disclosed", "text": "Every active and its amount is named on the label. No proprietary blend." } },
        { "type": "card", "settings": { "icon": "leaf", "title": "Grass-fed base", "text": "Set in 100% grass-fed bovine gelatin for a dense, softened-cube chew." } },
        { "type": "card", "settings": { "icon": "calendar", "title": "Two a day", "text": "Two gummies per serving. 30 gummies and 15 servings in every jar." } }
      ]
    }
  ]
}
{% endschema %}