{% comment %}
  Section contract.
  Drive FAQ: sticky heading beside question-and-answer dropdowns (Question blocks),
  followed by the supplement disclaimer.
  @example
  <!-- Section in templates/product.drive.json -->
{% endcomment %}
{%- assign questions = section.blocks | where: 'type', 'question' -%}
{% render 'reserve-drive-styles' %}

<div class="dp">
  <section class="dp-sec dp-faq" id="dp-faq-{{ section.id }}">
    <div class="dp-wrap dp-faq-grid">
      <div class="dp-faq-head">
        <h2 class="dp-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.sub != blank -%}<p class="dp-sub">{{ section.settings.sub | escape }}</p>{%- endif -%}
      </div>
      <div>
        <div class="dp-acc">
          {%- for block in questions -%}
            {%- if block.settings.question != blank and block.settings.answer != blank -%}
              <details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="dp-acc-body"><p>{{ block.settings.answer | escape | newline_to_br }}</p></div></details>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.legal != blank -%}<p class="dp-legal">{{ section.settings.legal | escape }}</p>{%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Drive FAQ",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered plainly." },
    { "type": "textarea", "id": "sub", "label": "Intro", "default": "Everything you need to know about Drive before your first jar." },
    { "type": "textarea", "id": "legal", "label": "Disclaimer", "default": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Drive FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How do I take Drive?", "answer": "Two gummies per serving. Each jar holds 30 gummies, or 15 daily servings." } },
        { "type": "question", "settings": { "question": "What is in the formula?", "answer": "Tongkat Ali root extract, zinc, and boron. The final extract specification and ingredient forms are confirmed before production." } },
        { "type": "question", "settings": { "question": "Is Drive vegetarian or vegan?", "answer": "No. Drive is made with 100% grass-fed bovine gelatin." } },
        { "type": "question", "settings": { "question": "What else is in the gummy?", "answer": "Honey, purified water, natural flavor, citric acid, malic acid, coconut oil or MCT oil, carnauba wax, and fruit or vegetable juice concentrate for color if needed." } },
        { "type": "question", "settings": { "question": "When are final doses confirmed?", "answer": "The displayed amounts are targets. Final doses, stability, labeling, and regulatory requirements are confirmed before production." } }
      ]
    }
  ]
}
{% endschema %}