<style>
  .rp3{background:var(--paper);padding:110px 0 90px;border-bottom:1px solid var(--line)}
  .rp3-grid{display:grid;grid-template-columns:1.05fr 1fr;align-items:start}
  .rp3-copy{padding-right:72px}
  .rp3-eye{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#a4563b;margin:0 0 30px}
  .rp3-h{font-family:Georgia,"Iowan Old Style","Palatino Linotype","Times New Roman",serif;font-weight:400;font-size:clamp(34px,4.6vw,var(--rp3-size,56px));line-height:1.04;letter-spacing:-.025em;color:#171a1c;margin:0 0 44px;max-width:none;text-wrap:balance}
  .rp3-body p{font-size:17.5px;line-height:1.72;color:#43474a;margin:0 0 28px;max-width:600px}
  .rp3-body p:last-child{margin-bottom:0}
  .rp3-body strong,.rp3-body b{color:#171a1c;font-weight:700}
  .rp3-side{border-left:1px solid #e0dbd3;padding-left:80px}
  .rp3-st{font-family:Georgia,"Iowan Old Style","Palatino Linotype","Times New Roman",serif;font-weight:400;font-size:clamp(28px,2.7vw,38px);line-height:1.1;letter-spacing:-.02em;color:#171a1c;margin:0 0 18px}
  .rp3-list{list-style:none;margin:0;padding:0}
  .rp3-item{display:grid;grid-template-columns:104px 1fr;align-items:center;padding:30px 0;border-bottom:1px solid #e6e1d9}
  .rp3-art{width:104px;height:104px;border-radius:18px;background:#efe8de;overflow:hidden;display:flex;align-items:center;justify-content:center}
  .rp3-art svg{width:100%;height:100%;display:block}
  .rp3-art img{width:100%;height:100%;object-fit:cover;display:block}
  .rp3-item:last-child{border-bottom:0;padding-bottom:0}
  .rp3-txt{padding:0 0 0 32px}
  .rp3-ie{font-size:10.5px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#a4563b;margin:0 0 8px}
  .rp3-it{font-family:Georgia,"Iowan Old Style","Palatino Linotype","Times New Roman",serif;font-weight:400;font-size:26px;line-height:1.18;letter-spacing:-.015em;color:#171a1c;margin:0 0 10px}
  .rp3-id{font-size:15px;line-height:1.6;color:#555a5d;margin:0;max-width:440px}
  .rp3-foot{margin-top:64px;padding-top:22px;border-top:1px solid #e0dbd3}
  .rp3-foot p{font-size:14px;line-height:1.6;color:#555a5d;margin:0}
  .rp3-foot strong{color:#171a1c;font-weight:700}
  @media(max-width:900px){
    .rp3{padding:76px 0 64px}
    .rp3-grid{grid-template-columns:1fr}
    .rp3-copy{padding-right:0}
    .rp3-side{border-left:0;padding-left:0;border-top:1px solid #e0dbd3;margin-top:52px;padding-top:48px}
  }
  @media(max-width:640px){
    .rp3{padding:60px 0 52px}
    .rp3-eye{font-size:10px;margin-bottom:20px}
    .rp3-h{font-size:calc(var(--rp3-size,56px)*.7);margin-bottom:28px}
    .rp3-body p{font-size:16px;line-height:1.66;margin-bottom:20px}
    .rp3-st{font-size:28px;margin-bottom:6px}
    .rp3-item{grid-template-columns:76px 1fr;padding:24px 0}
    .rp3-art{width:76px;height:76px;border-radius:14px}
    .rp3-txt{padding-left:20px}
    .rp3-ie{font-size:9.5px;margin-bottom:6px}
    .rp3-it{font-size:21px;margin-bottom:8px}
    .rp3-id{font-size:14.5px}
    .rp3-foot{margin-top:44px}
    .rp3-foot p{font-size:13px}
  }
</style>
<section class="rp3" id="potency" style="--rp3-size:{{ section.settings.pot_title_size | default: 56 }}px">
  <div class="wrap">
    <div class="rp3-grid">
      <div class="rp3-copy">
        {%- if section.settings.pot_eyebrow != blank -%}<p class="rp3-eye">{{ section.settings.pot_eyebrow }}</p>{%- endif -%}
        <h2 class="rp3-h">{{ section.settings.pot_title | default: 'Most gummies are BS.' }}</h2>
        <div class="rp3-body">{{ section.settings.pot_body | default: '<p>Most gummies are made like candy. The base is glucose syrup and sugar, set with pectin or starch, and the actives get whatever room is left. When labs test them, the dose often doesn’t match the label.</p><p><strong>We use real ingredients.</strong> Real fruit, research‑backed actives at the doses used in human studies, and every amount printed on the label. No seed oils, nothing artificial.</p><p><strong>We use 100% grass‑fed beef gelatin, while others use pectin or starch.</strong> Classic pectin won’t set unless the mix is more than 55% sugar and other dissolved solids. Gelatin sets on its own, it’s over 92% protein, and it gives every gummy a dense, clean chew that melts in your mouth.</p>' }}</div>
      </div>
      <div class="rp3-side">
        <h3 class="rp3-st">{{ section.settings.pot_side_title | default: 'What we do differently' }}</h3>
        <ol class="rp3-list">
          <li class="rp3-item"><div class="rp3-art">{%- if section.settings.pot_i1_image != blank -%}{{ section.settings.pot_i1_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: section.settings.pot_i1_title }}{%- else -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="#171a1c" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 25 C24 21 40 21 47 23 C52 24 54 28 53 33 C52 38 49 40 45 40 H25 C21 40 19 37 19 34"/><path d="M20 25 C16 27 13 32 11 38"/><path d="M19 34 C17 36 15 39 14 42"/><path d="M11 38 C9 40 8 43 9 45 C10 47 13 47 14 45 L14 42"/><path d="M12 37 L9 34"/><path d="M25 40 V50 M30 40 V50 M42 40 V50 M47 39 V50"/><path d="M53 27 C56 30 56 35 55 39"/><path d="M54.5 39 l1 2.5"/><path d="M34 33 C35 30 39 29 41 31 C42 33 40 35 37 35 C35 35 34 34 34 33 Z" fill="#a4563b" stroke="none"/><path d="M3 50 H61"/><path d="M6 50 l1.5 -4 M9 50 l0.5 -5 M12 50 l-1 -3.5 M15 50 l1 -3" stroke="#6f7d4a"/></svg>{%- endif -%}</div><div class="rp3-txt">{%- if section.settings.pot_i1_eyebrow != blank -%}<p class="rp3-ie">{{ section.settings.pot_i1_eyebrow }}</p>{%- endif -%}<h4 class="rp3-it">{{ section.settings.pot_i1_title }}</h4><p class="rp3-id">{{ section.settings.pot_i1_text }}</p></div></li>
          <li class="rp3-item"><div class="rp3-art">{%- if section.settings.pot_i2_image != blank -%}{{ section.settings.pot_i2_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: section.settings.pot_i2_title }}{%- else -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="#171a1c" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="28" cy="37" r="15"/><circle cx="28" cy="37" r="11" stroke="#a4563b"/><path d="M28 26 V48 M17 37 H39 M20.2 29.2 L35.8 44.8 M35.8 29.2 L20.2 44.8" stroke="#a4563b" stroke-width="1.2"/><path d="M28 22 C28 18 30 15 33 13"/><path d="M30 17 C34 12 41 12 43 14 C40 18 35 19 30 17 Z" fill="#6f7d4a" stroke="#6f7d4a"/><path d="M50 30 C47 35 46 37 46 39 C46 41.5 48 43 50 43 C52 43 54 41.5 54 39 C54 37 53 35 50 30 Z" fill="#a4563b" stroke="none"/></svg>{%- endif -%}</div><div class="rp3-txt">{%- if section.settings.pot_i2_eyebrow != blank -%}<p class="rp3-ie">{{ section.settings.pot_i2_eyebrow }}</p>{%- endif -%}<h4 class="rp3-it">{{ section.settings.pot_i2_title }}</h4><p class="rp3-id">{{ section.settings.pot_i2_text }}</p></div></li>
          <li class="rp3-item"><div class="rp3-art">{%- if section.settings.pot_i3_image != blank -%}{{ section.settings.pot_i3_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: section.settings.pot_i3_title }}{%- else -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="#171a1c" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 H38"/><path d="M25 10 V25 L13 47 C11 51 13 54 17 54 H43 C47 54 49 51 47 47 L35 25 V10"/><path d="M17.5 39 C23 37 28 41 33 39 C37 37.5 40 38 42.5 39 L47 47 C49 51 47 54 43 54 H17 C13 54 11 51 13 47 Z" fill="#a4563b" stroke="none" opacity=".9"/><path d="M25 18 H29 M25 23 H29"/><circle cx="47" cy="17" r="8" fill="#efe8de"/><path d="M43.5 17 l2.5 2.5 l5 -5"/></svg>{%- endif -%}</div><div class="rp3-txt">{%- if section.settings.pot_i3_eyebrow != blank -%}<p class="rp3-ie">{{ section.settings.pot_i3_eyebrow }}</p>{%- endif -%}<h4 class="rp3-it">{{ section.settings.pot_i3_title }}</h4><p class="rp3-id">{{ section.settings.pot_i3_text }}</p></div></li>
        </ol>
      </div>
    </div>
    {%- if section.settings.pot_why != blank or section.settings.pot_source != blank -%}
    <div class="rp3-foot">
      {%- if section.settings.pot_why != blank -%}<p><strong>Why it matters:</strong> {{ section.settings.pot_why }}</p>{%- endif -%}
      {%- if section.settings.pot_source != blank -%}<p><strong>Sources:</strong> {{ section.settings.pot_source }}</p>{%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}{"name": "Potency", "settings": [{"type": "text", "id": "pot_eyebrow", "label": "Eyebrow", "info": "Leave empty to hide."}, {"type": "text", "id": "pot_title", "label": "Headline", "default": "Most gummies are BS."}, {"type": "range", "id": "pot_title_size", "label": "Headline size (desktop)", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 56, "info": "Phones use about 70% of this size."}, {"type": "richtext", "id": "pot_body", "label": "Body", "default": "<p>Most gummies are made like candy. The base is glucose syrup and sugar, set with pectin or starch, and the actives get whatever room is left. When labs test them, the dose often doesn’t match the label.</p><p><strong>We use real ingredients.</strong> Real fruit, research‑backed actives at the doses used in human studies, and every amount printed on the label. No seed oils, nothing artificial.</p><p><strong>We use 100% grass‑fed beef gelatin, while others use pectin or starch.</strong> Classic pectin won’t set unless the mix is more than 55% sugar and other dissolved solids. Gelatin sets on its own, it’s over 92% protein, and it gives every gummy a dense, clean chew that melts in your mouth.</p>"}, {"type": "text", "id": "pot_side_title", "label": "Right column title", "default": "What we do differently"}, {"type": "header", "content": "Point 1"}, {"type": "image_picker", "id": "pot_i1_image", "label": "Image", "info": "Square works best. Leave empty to show the built-in icon."}, {"type": "text", "id": "pot_i1_eyebrow", "label": "Eyebrow", "info": "Leave empty to hide."}, {"type": "text", "id": "pot_i1_title", "label": "Title", "default": "100% grass‑fed beef gelatin"}, {"type": "textarea", "id": "pot_i1_text", "label": "Text", "default": "Not pectin or starch. A protein base that sets without a sugar-heavy mix."}, {"type": "header", "content": "Point 2"}, {"type": "image_picker", "id": "pot_i2_image", "label": "Image", "info": "Square works best. Leave empty to show the built-in icon."}, {"type": "text", "id": "pot_i2_eyebrow", "label": "Eyebrow", "info": "Leave empty to hide."}, {"type": "text", "id": "pot_i2_title", "label": "Title", "default": "Real fruit, nothing artificial"}, {"type": "textarea", "id": "pot_i2_text", "label": "Text", "default": "No seed oils, no artificial colors, flavors or sweeteners."}, {"type": "header", "content": "Point 3"}, {"type": "image_picker", "id": "pot_i3_image", "label": "Image", "info": "Square works best. Leave empty to show the built-in icon."}, {"type": "text", "id": "pot_i3_eyebrow", "label": "Eyebrow", "info": "Leave empty to hide."}, {"type": "text", "id": "pot_i3_title", "label": "Title", "default": "Full doses, tested"}, {"type": "textarea", "id": "pot_i3_text", "label": "Text", "default": "Every active at the dose used in human research, printed on the label and tested in the finished product."}, {"type": "header", "content": "Footnote"}, {"type": "textarea", "id": "pot_why", "label": "Why it matters", "info": "Leave empty to hide."}, {"type": "text", "id": "pot_source", "label": "Source", "info": "Leave empty to hide."}], "presets": [{"name": "Potency"}]}{% endschema %}
