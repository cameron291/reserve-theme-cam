<section class="wrap cart"><h1>Your bag.</h1>{% if cart.item_count == 0 %}<p class="empty">Your bag is currently empty.</p><a class="button button-dark" href="{{ routes.root_url }}">Return to Reserve</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-line"><div><strong>{{ item.product.title }}</strong><br><span>{{ item.variant.title }}</span></div><span>{{ item.quantity }}</span><span>{{ item.final_line_price | money }}</span></div>{% endfor %}<div class="cart-summary"><strong>Total {{ cart.total_price | money }}</strong><button class="button button-dark" type="submit" name="checkout">Checkout</button></div></form>{% endif %}</section>
{% schema %}{"name":"Reserve cart","settings":[]} {% endschema %}