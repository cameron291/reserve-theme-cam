{% doc %}
  Drive product page gallery: main image, a row of image slots (real product media
  first, then placeholders until the planned count is reached) with arrows, and the
  supplement facts button. Empty slots stay visible so the planned images are clear
  while photography is in progress.
  @param {object} product - Product whose media to show
  @param {object} section - Buy box section, for the facts button label
  @param {boolean} show_facts - Whether to show the supplement facts button (it opens the dialog in the Drive ingredients section)
  @example
  {% render 'reserve-drive-pdp-gallery', product: product, section: section, show_facts: true %}
{% enddoc %}
{%- liquid
  # Planned number of product images. Slots without a real image show a placeholder.
  assign slots = 5
  assign ph_count = slots | minus: product.media.size
  if ph_count < 0
    assign ph_count = 0
  endif
  assign total = product.media.size | plus: ph_count
  assign main_alt = product.featured_media.alt | default: product.title
-%}
<div class="dp-gallery">
  <div class="dp-main">
    {%- if product.featured_media -%}
      {{ product.featured_media.preview_image | image_url: width: 1600 | image_tag: alt: main_alt, class: 'dp-main-img', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 52vw, 100vw' }}
    {%- endif -%}
    <div class="dp-main-ph" data-dp-main-ph{% if product.featured_media %} hidden{% endif %}>{{ 'product-1' | placeholder_svg_tag }}</div>
    {%- if total > 1 -%}
      <button type="button" class="dp-arrow dp-prev" data-dp-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" class="dp-arrow dp-next" data-dp-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg></button>
    {%- endif -%}
  </div>
  {%- if total > 1 -%}
    <div class="dp-thumbs">
      {%- for media in product.media -%}
        {%- assign thumb_alt = media.alt | default: product.title -%}
        <button type="button" class="dp-thumb" data-dp-thumb data-src="{{ media.preview_image | image_url: width: 1600 }}" data-alt="{{ thumb_alt | escape }}" aria-label="Show image {{ forloop.index }} of {{ total }}"{% if forloop.first %} aria-current="true"{% endif %}>{{ media.preview_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}</button>
      {%- endfor -%}
      {%- if ph_count > 0 -%}
        {%- for i in (1..ph_count) -%}
          {%- assign slot = product.media.size | plus: i -%}
          {%- assign ph_n = slot | minus: 1 | modulo: 6 | plus: 1 -%}
          {%- assign ph_name = 'product-' | append: ph_n -%}
          <button type="button" class="dp-thumb" data-dp-thumb data-dp-ph aria-label="Show image {{ slot }} of {{ total }} (placeholder)"{% if slot == 1 %} aria-current="true"{% endif %}>{{ ph_name | placeholder_svg_tag }}</button>
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if show_facts -%}
    <button type="button" class="dp-pill-btn" data-dp-sf-open aria-controls="dp-sfd">{% render 'reserve-drive-icon', name: 'doc' %}{{ section.settings.facts_button | default: 'View supplement facts' | escape }}</button>
  {%- endif -%}
</div>