ht:72%;border-radius:50%;background:var(--sage);top:12%;left:14%}.visual:after{content:"";position:absolute;width:44%;height:44%;border-radius:50%;background:var(--peach);right:0;bottom:6%;opacity:.75}.jar{position:relative;width:38%;aspect-ratio:.78;background:linear-gradient(100deg,#111411,#292d28 45%,#080a08);border-radius:10px 10px 18px 18px;box-shadow:20px 28px 40px #1a221d33;z-index:1}.jar:before{content:"";position:absolute;left:-3%;top:-5%;width:106%;height:12%;background:linear-gradient(100deg,#292d28,#0c0e0c);border-radius:50%;box-shadow:0 7px 0 #0b0d0b}.label{position:absolute;background:#e8e4d9;left:12%;right:12%;top:29%;bottom:15%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#252923}.label strong{font-size:10px;letter-spacing:.22em;text-transform:uppercase}.label span{font-size:8px;letter-spacing:.1em;text-transform:uppercase;margin-top:11px;color:#6b7068}.section{padding:105px 0;border-bottom:1px solid var(--line)}.paper{background:var(--paper)}.section-head{display:flex;justify-content:space-between;gap:40px;align-items:flex-end;margin-bottom:48px}.section h2{font-size:clamp(36px,5vw,62px);line-height:1;letter-spacing:-.055em;font-weight:500;margin:0;max-width:650px}.lead{max-width:370px;color:var(--muted);font-size:15px;line-height:1.6;margin:0}.standard{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.standard article{background:var(--ivory);padding:31px;min-height:205px}.index{font-size:11px;letter-spacing:.14em;color:var(--muted)}.standard h3{font-size:18px;font-weight:500;margin:44px 0 12px}.standard p,.note{font-size:14px;line-height:1.55;color:var(--muted);margin:0}.flavors{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.flavor{min-height:250px;padding:28px;display:flex;flex-direction:column;justify-content:space-between}.flavor:nth-child(1){background:#dce6d4}.flavor:nth-child(2){background:#ecd1c3}.flavor:nth-child(3