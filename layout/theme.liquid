@media(max-width:800px){.rn-ann{font-size:10px;letter-spacing:.08em}.rn-hd-in{height:60px;gap:10px}.rn-wm{grid-column:2}.rn-utils{grid-column:3}.rn-utils a{font-size:10px;letter-spacing:.1em}.rn-navmain{display:none}.rn-wm{font-size:13px;letter-spacing:.18em}.rn-utils{gap:14px}.rn-acct{display:none}}
