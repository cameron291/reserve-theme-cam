1{font-size:clamp(44px,6vw,76px);line-height:.94;letter-spacing:-.06em;font-weight:500;margin:0 0 22px}.price{font-size:18px;margin:0 0 28px}.description{color:var(--muted);line-height:1.65;font-size:15px;margin-bottom:30px}.product-form{border-top:1px solid var(--line);padding-top:25px}.product-form label{display:block;color:var(--muted);font-size:11px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:10px}.product-form .button{width:100%}.cart-line{display:grid;grid-template-columns:1fr 120px 120px;gap:25px;border-top:1px solid var(--line);padding:22px 0}.cart-line strong{font-weight:500}.cart-line span{color:var(--muted);font-size:14px}.cart-summary{border-top:1px solid var(--line);padding-top:24px;display:flex;justify-content:flex-end;gap:25px;align-items:center}.empty{color:var(--muted);font-size:17px}
@media(max-width:800px){.wrap{padding:0 18px}.header-inner{height:66px}.nav{gap:13px;font-size:10px}.nav a:not(:last-child){display:none}.hero{display:block}.hero-copy{padding:72px 0 58px}.visual{min-height:430px}.jar{width:42%}.section{padding:76px 0}.section-head{display:block;margin-bottom:34px}.section-head .lead{margin-top:20px}.standard,.flavors{grid-template-columns:1fr}.standard article{min-height:170px}.standard h3{margin-top:32px}.ingredients,.join,.product-grid{grid-template-columns:1fr;gap:36px}.form-row{grid-template-columns:1fr}.product-media{min-height:450px}.cart-line{grid-template-columns:1fr auto}.cart-line span:nth-child(2){display:none}.cart-summary{justify-content:space-between}.footer-inner{align-items:flex-start;flex-direction:column}}
